<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compila el interprete original de servidor/ para usarlo desde la web -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>servidor</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0162;CS0168;CS0169;CS0219;CS0414;CS0649;CS8321</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../servidor/**/*.cs" Exclude="../servidor/Program.cs;../servidor/Prueba.cs;../servidor/Tests.cs;../servidor/Properties/**;../servidor/obj/**;../servidor/bin/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Irony" Version="1.1.0" />
  </ItemGroup>

</Project>
